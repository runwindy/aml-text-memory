# Local DeepSeek experiment only.
# Do NOT use this configuration for the open-source / academic leaderboard,
# which requires gpt-4o-mini for LLM components.
#
# Keep text-embedding-v4 for embedding so retrieval remains comparable.

AML_AUTH_MODE=none
AML_MEMORY_SYSTEM_KEY=change-me
AML_DATABASE_PATH=D:\workspace\memory\amc\longmemeval_s_deepseek.db

# Embedding stays on the official model for comparable vectors.
AML_EMBEDDING_PROVIDER=openai
AML_EMBEDDING_MODEL=text-embedding-v4
AML_EMBEDDING_API_BASE=https://your-embedding-compatible/v1
AML_EMBEDDING_API_KEY=replace-me
AML_EMBEDDING_BATCH_SIZE=10

# DeepSeek is used through the decomposer path.
# The organizer is only used when decomposer is off, so keep it deterministic.
AML_ORGANIZER_PROVIDER=rule

AML_DECOMPOSER_PROVIDER=deepseek
AML_DECOMPOSER_MODEL=deepseek-v4.1-flash
AML_DECOMPOSER_API_BASE=https://your-deepseek-compatible/v1
AML_DECOMPOSER_API_KEY=replace-me

# Reranker is unrestricted by AML; lexical is the cheapest local option.
AML_RERANKER_PROVIDER=lexical
AML_RETRIEVAL_CANDIDATE_K=10000
AML_MAX_RETURN_ITEMS=100
AML_MAX_CONTENT_CHARS=4000

# JEPA-inspired predictive memory layer (optional local experiment).
# This adds extra embedding calls for assistant-context surprise scoring.
AML_PREDICTIVE_MEMORY_ENABLED=false
AML_PREDICTION_SURPRISE_THRESHOLD=0.35
AML_PREDICTIVE_RERANK_WEIGHT=0.15

# Graph-JEPA style predicted links (optional).
AML_GRAPH_LINK_PREDICTION_ENABLED=false
AML_GRAPH_LINK_PREDICTION_TOP_K=8
AML_GRAPH_LINK_PREDICTION_THRESHOLD=0.55
AML_GRAPH_LINK_PREDICTION_WEIGHT=0.5
AML_GRAPH_LINK_PREDICTION_MAX_NODES=200

# Dialogue-JEPA latent query expansion (optional; requires a trained model).
AML_JEPA_QUERY_EXPANSION_ENABLED=false
AML_JEPA_MODEL_PATH=D:\workspace\memory\aml-text-memory\data\dialogue_jepa.pt
AML_JEPA_BLEND_WEIGHT=0.5

# If no trained Dialogue-JEPA checkpoint exists, use a training-free
# pseudo-relevance centroid as the JEPA query expansion fallback.
AML_JEPA_QUERY_EXPANSION_FALLBACK=true
AML_JEPA_PSEUDO_RELEVANCE_SEED_K=20
AML_JEPA_PSEUDO_RELEVANCE_WEIGHT=0.5

# Persistent dialogue tree / graph retrieval expansion.
AML_DIALOGUE_TREE_EXPANSION_ENABLED=false
AML_DIALOGUE_TREE_WEIGHT=0.7
AML_DIALOGUE_TREE_DECAY=0.7
AML_DIALOGUE_TREE_MAX_HOPS=2

# Async Add processing: sync raw ingest, async structured Gold/tree/graph.
AML_ASYNC_PROCESSING_ENABLED=false
AML_ASYNC_WORKER_ENABLED=false
AML_ASYNC_WORKER_POLL_INTERVAL=1.0
