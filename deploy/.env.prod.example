# AML Text Memory - production VPS environment
# Copy this file to the repository root as .env before docker compose up.

AML_AUTH_MODE=bearer
AML_MEMORY_SYSTEM_KEY=replace-with-a-long-random-secret

AML_DATABASE_PATH=/app/data/aml.db

AML_EMBEDDING_PROVIDER=openai
AML_EMBEDDING_MODEL=text-embedding-v4
AML_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AML_EMBEDDING_API_KEY=replace-with-your-embedding-api-key
AML_EMBEDDING_BATCH_SIZE=10

AML_MAX_RETURN_ITEMS=100
AML_MAX_CONTENT_CHARS=4000
